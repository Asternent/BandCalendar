<template>
  <div class="root" style="height: {{ viewportHeight }}px">
    <list id="calendar-list" show="{{ !detail && !legal && !jump && !options }}" class="screen" style="height: {{ viewportHeight }}px">
      <list-item type="head" class="head-item"><div class="head">
        <div class="title-row"><text class="title">腕上日曆</text><text class="top-action" @click="goToday">今天</text><text class="top-action" @click="openOptions">選單</text></div>
        <div class="month-row"><text class="arrow" style="color: {{ previousColor }}" @click="previous">‹</text><text class="month-title" @click="openJump">{{ monthTitle }} ▾</text><text class="arrow" style="color: {{ nextColor }}" @click="next">›</text></div>
      </div></list-item>
      <list-item type="preview" class="preview-item"><div class="preview" @click="openDetail"><text class="preview-title" style="color: {{ selectedRestColor }}">{{ previewTitle }}</text><text class="preview-subtitle">{{ navHint || previewSubtitle }}</text></div></list-item>
      <list-item type="weeknames" class="weeknames-item"><div class="weeknames"><text for="{{ weekdays }}" class="weekday">{{ $item }}</text></div></list-item>
      <list-item type="week" for="{{ weeks }}" class="week-item"><div class="week"><div for="{{ $item.days }}" class="cell" style="background-color: {{ $item.background }}" @click="selectDate($item.key)">
        <text class="day" style="color: {{ $item.color }}">{{ $item.day }}</text><text class="badge" style="color: {{ $item.badgeColor }}">{{ $item.badge }}</text><text class="lunar" style="color: {{ $item.subColor }}">{{ $item.label }}</text>
      </div></div></list-item>
      <list-item type="date-colors" class="date-colors-item"><div class="date-colors"><text class="legend-rest">紅：放假</text><text class="legend-work">綠：補班</text><text class="legend-weekend">藍：週末</text></div></list-item>
      <list-item type="usage" class="usage-item"><text class="hint">{{ navHint || '點日期選取 · 再點同日或上方摘要看詳情' }}</text></list-item>
      <list-item type="break-heading" class="section-item"><text class="section">本月假期</text></list-item>
      <list-item type="break-empty" if="{{ monthRuns.length === 0 }}" class="break-empty-item"><div class="break-content"><text class="empty-title">{{ monthBreakTitle }}</text><text class="muted">{{ monthBreakRange }}</text></div></list-item>
      <list-item type="holiday-run" for="{{ monthRuns }}" class="holiday-item"><div class="holiday-card" @click="showDateDetail($item.start)"><text class="holiday-name">{{ $item.name }} · 連休 {{ $item.days }} 天 ›</text><text class="muted">{{ $item.range }}</text></div></list-item>
      <list-item type="calendar-foot" class="calendar-foot"><div class="foot-content"><text class="muted">一般週末按週休二日參考</text><text class="muted">全球節日不代表大陸放假</text><text class="muted">節日 2025–2028 · 調休 2025–2026</text><text class="link" @click="openOptions">顯示範圍、同步與資料來源 ›</text></div></list-item>
    </list>
    <list id="detail-list" if="{{ detailReady }}" show="{{ detail && !legal && !jump && !options }}" class="screen" style="height: {{ viewportHeight }}px">
      <list-item type="back" class="back-item"><text class="back" @click="closeDetail">‹ 返回月曆</text></list-item>
      <list-item type="day-navigation" class="day-nav-item"><div class="day-nav"><text class="day-action" style="color: {{ previousDayColor }}" @click="previousDay">‹ 前一天</text><text class="day-action" @click="detailToday">今天</text><text class="day-action" style="color: {{ nextDayColor }}" @click="nextDay">後一天 ›</text></div></list-item>
      <list-item type="detailhead" class="detail-head-item"><div class="detail-head"><text class="detail-date">{{ detailDate }}</text><text class="detail-lunar">{{ detailLunar }}</text><text class="selected-rest" style="color: {{ selectedRestColor }}">{{ selectedRest }}</text><text class="detail-status">{{ selectedStatus }}</text><text class="muted">{{ detailCount }}</text><text class="hint">{{ navHint }}</text></div></list-item>
      <list-item type="empty" if="{{ detailEvents.length === 0 }}" class="empty-item"><text class="empty-title">當日未收錄節日</text></list-item>
      <list-item type="event" for="{{ detailEvents }}" class="event-item" style="height: {{ $item.height }}px"><div class="event-content" style="height: {{ $item.height - 8 }}px"><text class="event-kind" style="color: {{ $item.color }}">{{ $item.kindLabel }}</text><text class="event-name" style="height: {{ $item.titleHeight }}px">{{ $item.n }}</text><text class="event-country">{{ $item.c }}</text></div></list-item>
      <list-item type="pager" if="{{ detailPages > 1 }}" class="pager-item"><div class="pager"><text class="page-button" style="color: {{ previousPageColor }}" @click="previousDetailPage">‹ 上頁</text><text class="page-label">{{ detailPageLabel }}</text><text class="page-button" style="color: {{ nextPageColor }}" @click="nextDetailPage">下頁 ›</text></div></list-item>
      <list-item type="detail-return" class="back-item"><text class="back" @click="closeDetail">‹ 返回選中日期</text></list-item>
      <list-item type="notice" class="notice-item"><div class="notice"><text class="muted">各國公眾假期供參考，未來或宗教日期可能調整；不含所有地方假期。</text><text class="muted">紅／綠日期只以大陸官方安排標記；更多原名與適用地區見手機。</text><text class="muted">資料：Python holidays、香港天文台、國務院、聯合國。</text></div></list-item>
    </list>
    <list if="{{ jumpReady }}" show="{{ jump }}" class="screen" style="height: {{ viewportHeight }}px">
      <list-item type="jump-back" class="back-item"><text class="back" @click="closeJump">‹ 取消，返回月曆</text></list-item>
      <list-item type="year-navigation" class="year-item"><div class="year-nav"><text class="arrow" style="color: {{ previousYearColor }}" @click="previousYear">‹</text><text class="year">{{ jumpYear }} 年</text><text class="arrow" style="color: {{ nextYearColor }}" @click="nextYear">›</text></div></list-item>
      <list-item type="jump-hint" class="jump-hint"><text class="hint">{{ navHint || '選擇月份立即前往 · 保留所選日期' }}</text></list-item>
      <list-item type="month-choice" for="{{ jumpRows }}" class="month-choice-item"><div class="month-choices"><text for="{{ $item.months }}" class="month-choice" style="background-color: {{ $item.background }}" @click="chooseMonth($item.month)">{{ $item.label }}</text></div></list-item>
      <list-item type="jump-today" class="back-item"><text class="back" @click="goToday">回到今天</text></list-item>
    </list>
    <list if="{{ optionsReady }}" show="{{ options }}" class="screen" style="height: {{ viewportHeight }}px">
      <list-item type="options-back" class="back-item"><text class="back" @click="closeOptions">‹ 返回月曆</text></list-item>
      <list-item type="options-heading" class="options-heading"><div class="options-content"><text class="options-title">顯示與同步</text><text class="muted">{{ scopeSource }}</text></div></list-item>
      <list-item type="scope-global" class="option-item"><text class="option" @click="chooseGlobal">{{ globalLabel }}</text></list-item>
      <list-item type="scope-cn" class="option-item"><text class="option" @click="chooseChina">{{ chinaLabel }}</text></list-item>
      <list-item type="scope-phone" class="option-item"><text class="option" @click="followPhone">{{ phoneScopeLabel }}</text></list-item>
      <list-item type="options-help" class="options-help"><text class="hint">臨時範圍不修改手機；其他國家請從手機選擇，再恢復手機設定。</text></list-item>
      <list-item type="sync-action" class="option-item"><text class="option" @click="requestSync">{{ syncLabel }}</text></list-item>
      <list-item type="sync-status" class="sync-status-item"><text class="hint">{{ syncStatus }}</text></list-item>
      <list-item type="legal-action" class="option-item"><text class="option" @click="openLegal">資料來源與免責聲明 ›</text></list-item>
    </list>
    <list if="{{ legal }}" class="screen" style="height: {{ viewportHeight }}px">
      <list-item type="legal-back" class="back-item"><text class="back" @click="closeLegal">‹ 返回上一頁</text></list-item>
      <list-item type="legal-source" class="legal-source"><text class="legal-text">全球節日：Python holidays 0.87（MIT）。地區名稱：Babel / CLDR。大陸調休：國務院 2025／2026 通知。國際紀念日：聯合國。完整授權附於安裝包，亦可在手機「資料來源與授權」閱讀。</text></list-item>
      <list-item type="legal-paragraph" for="{{ legalParagraphs }}" class="legal-item"><text class="legal-text">{{ $item }}</text></list-item>
    </list>
  </div>
</template>
<script>
import interconnect from '@system.interconnect'
import storage from '@system.storage'
import device from '@system.device'
const calendar=require('../../common/calendar')
const protocol=require('../../common/protocol')
const nav=require('../../common/navigation')
const legalParagraphs=require('../../common/legal')
const kinds={rest:'大陸官方放假',work:'大陸官方補班',regional:'大陸節日／紀念日',traditional:'傳統節日',global:'國際／民俗節日',solar:'二十四節氣',national:'國別公眾假期'}
export default {
  private:{
    viewportHeight:456,monthTitle:'',monthBreakTitle:'',monthBreakRange:'',monthRuns:[],
    selectedRest:'',selectedRestColor:'#CAC4D0',previewTitle:'',previewSubtitle:'',
    weeks:[],weekdays:[],selectedLabel:'',selectedLunar:'',selectedEvent:'',selectedStatus:'',
    scopeLabel:'全球',scopeSource:'預設範圍',syncStatus:'離線資料已內建',syncPending:false,syncLabel:'同步手機設定',
    detail:false,detailEvents:[],detailDate:'',detailLunar:'',detailCount:'',detailReady:false,detailPages:1,detailPageLabel:'第 1 / 1 頁',
    legal:false,legalParagraphs:legalParagraphs,jump:false,jumpReady:false,jumpYear:2026,jumpRows:[],
    options:false,optionsReady:false,globalLabel:'全球節日',chinaLabel:'僅中國大陸',phoneScopeLabel:'尚未同步手機設定',
    previousColor:'#D0BCFF',nextColor:'#D0BCFF',previousDayColor:'#D0BCFF',nextDayColor:'#D0BCFF',
    previousYearColor:'#D0BCFF',nextYearColor:'#D0BCFF',previousPageColor:'#625C68',nextPageColor:'#625C68',navHint:''
  },
  onInit(){
    this.settings=calendar.defaults();this.saved=null;this.saving=false;this.alive=true;this.gridStamp="";this.gridSelected="";this.detailCache=[];this.detailPage=0;this.scrollGeneration=0;this.hidden=false;this.sessionCountry=null;this.pendingSettings=null;this.syncGeneration=0;this.mainScrollGeneration=0;this.legalReturn='calendar'
    this.selected=calendar.valid(calendar.today())?calendar.today():calendar.data.minDate;this.monthKey=this.selected.slice(0,7)+'-01';this.preferredDay=Number(this.selected.slice(8));this.render()
    device.getInfo({success:(d)=>{if(this.alive&&d.screenWidth>0&&d.screenHeight>0)this.viewportHeight=Math.max(300,Math.round(d.screenHeight/d.screenWidth*336)-24)},fail:()=>{}})
    storage.get({key:'bandcalendar-settings-v1',success:(raw)=>{
      if(!this.alive)return;try{const p=JSON.parse(raw);if(protocol.validSaved(p)&&(!this.saved||Number(p.id)>Number(this.saved.id))&&!this.saving){this.saved=p;this.pendingSettings=p.settings;if(this.isCalendar()&&!this.hidden)this.applyPending();this.render()}}catch(e){}
      this.hello()
    },fail:()=>this.hello()})
  },
  onReady(){this.startBridge()},
  startBridge(){
    if(this.connection||!this.alive)return
    try{this.connection=interconnect.instance()}catch(e){this.connection=null;this.finishSync('此韌體暫無手機通訊 · 日曆可離線使用');return}
    if(!this.connection){this.finishSync('手機通道尚未就緒 · 日曆可離線使用');return}
    this.connection.onopen=()=>{if(!this.alive)return;this.send({type:'hello',v:1});this.syncStatus='手機已連線'}
    this.connection.onclose=()=>{if(this.alive)this.finishSync('手機已離線 · 日曆仍可使用')}
    this.connection.onerror=()=>{if(this.alive)this.finishSync('連線失敗 · 請開啟手機同步器')}
    this.connection.onmessage=(event)=>this.receive(event.data)
    this.hello()
  },
  isCalendar(){return !this.detail&&!this.legal&&!this.jump&&!this.options},
  setScreen(screen){this.scrollGeneration++;this.mainScrollGeneration++;this.detail=screen==='detail';this.legal=screen==='legal';this.jump=screen==='jump';this.options=screen==='options'},
  applySettings(settings){this.settings=Object.assign({},settings);if(this.sessionCountry!==null)this.settings.country=this.sessionCountry;this.summaryStamp=''},
  applyPending(){if(!this.pendingSettings)return;this.applySettings(this.pendingSettings);this.pendingSettings=null},
  onShow(){this.hidden=false;const today=calendar.today();if(this.isCalendar()){this.applyPending();if(this.lastToday&&today!==this.lastToday&&this.selected===this.lastToday)this.goToday();else this.render()}else this.render();this.lastToday=today},
  onHide(){this.hidden=true;this.scrollGeneration++;this.mainScrollGeneration++},
  hello(){if(!this.connection||!this.alive)return;this.connection.getReadyState({success:(s)=>{if(this.alive&&s.status===1)this.send({type:'hello',v:1})},fail:()=>{}})},
  send(p,onFail){if(!this.alive)return;if(!this.connection){if(onFail)onFail();return}try{this.connection.send({data:p,success:()=>{},fail:()=>{if(this.alive&&onFail)onFail()}})}catch(e){if(onFail)onFail()}},
  finishSync(message){this.syncGeneration++;this.syncPending=false;this.syncLabel='同步手機設定';if(this.waitTimer)clearTimeout(this.waitTimer);this.waitTimer=null;if(message)this.syncStatus=message},
  receive(raw){
    const p=protocol.parse(raw);if(!protocol.validPacket(p)||!this.alive)return
    if(this.saved&&Number(p.id)<Number(this.saved.id))return
    if(this.saved&&p.id===this.saved.id){this.send(calendar.sameSettings(p.settings,this.saved.settings)?protocol.ack(p):{type:'nack',v:1,id:p.id});return}
    if(this.saving)return
    this.saving=true
    storage.set({key:'bandcalendar-settings-v1',value:JSON.stringify(p),success:()=>{
      this.saving=false;if(!this.alive)return
      this.saved=p;this.pendingSettings=p.settings;if(this.isCalendar()&&!this.hidden)this.applyPending();this.render();this.finishSync(this.pendingSettings?'設定已儲存 · 返回月曆時套用':'手機設定已儲存');this.send(protocol.ack(p))
    },fail:()=>{this.saving=false;if(!this.alive)return;this.finishSync('儲存失敗，原設定保留');this.send({type:'nack',v:1,id:p.id})}})
  },
  requestSync(){
    if(this.syncPending||!this.alive)return false
    if(!this.connection)this.startBridge()
    if(!this.connection)return false
    this.syncPending=true;this.syncLabel='正在同步…';this.syncStatus='正在請求手機設定…';const generation=++this.syncGeneration
    this.send({type:'refresh',v:1},()=>{if(this.alive&&generation===this.syncGeneration)this.finishSync('傳送失敗 · 請先連接手機')})
    if(this.syncPending)this.waitTimer=setTimeout(()=>{if(this.alive&&generation===this.syncGeneration)this.finishSync('尚未收到確認 · 請開啟手機同步器再重試')},12000)
    return true
  },
  render(){
    if(this.hidden||this.legal)return
    if(this.jump){this.renderJump();return}
    if(this.options){this.renderOptions();return}
    if(this.isCalendar())this.renderGrid()
    this.renderSelection()
    if(this.detail)this.prepareDetail()
    this.updateNav()
  },
  patch(target,values){const keys=Object.keys(values);for(let i=0;i<keys.length;i++){const key=keys[i];if(target[key]!==values[key])target[key]=values[key]}},
  renderGrid(){
    const today=calendar.today(),stamp=this.monthKey+'|'+calendar.settingsKey(this.settings)+'|'+today
    if(stamp!==this.gridStamp){
      this.monthTitle=this.monthKey.slice(0,4)+'年 '+Number(this.monthKey.slice(5,7))+'月'
      this.weekdays=this.settings.monday?['一','二','三','四','五','六','日']:['日','一','二','三','四','五','六']
      const runs=calendar.monthBreaks(this.monthKey),monthRest=calendar.restInfo(this.monthKey)
      this.monthBreakTitle=runs.length?'本月：'+runs.map(r=>r.name+r.days+'天').join('／'):monthRest&&monthRest.covered?'本月無官方調休假期':'本年大陸調休未收錄'
      this.monthRuns=runs.map(r=>({name:r.name,days:r.days,start:r.start,range:this.shortDate(r.start)+'–'+this.shortDate(r.end)+(r.start.slice(0,7)!==r.end.slice(0,7)?'（跨月）':'')}))
      this.monthBreakRange=runs.length?runs.map(r=>this.shortDate(r.start)+'–'+this.shortDate(r.end)+(r.start.slice(0,7)!==r.end.slice(0,7)?'（跨月）':'')).join('、'):monthRest&&monthRest.covered?'一般週末按週休二日參考':'不推算假期或補班'
      const cells=calendar.month(this.monthKey,this.settings.monday,this.settings),create=this.weeks.length!==6,weeks=create?[]:this.weeks
      this.cellIndexes={}
      for(let r=0;r<6;r++){const days=create?[]:weeks[r].days;for(let col=0;col<7;col++){
        const c=cells[r*7+col],selected=c.key===this.selected,normal=c.restKind==='holiday'?'#FFB4AB':c.restKind==='work'?'#94D99A':c.restKind==='weekend'?'#A8C7FA':!c.inside?'#625C68':'#E6E0E9'
        const normalBg=!c.inside?'#141218':c.restKind==='holiday'?'#38242A':c.restKind==='work'?'#1B3026':c.restKind==='weekend'?'#1B293C':'#141218'
        const markColor=c.markerKind==='work'?'#94D99A':c.markerKind==='rest'?'#FFB4AB':c.markerShort?'#D0BCFF':'#AEA8B4'
        const next={key:c.key,day:c.day,badge:c.badge||(c.key===today?'今':''),label:!c.inside?Number(c.key.slice(5,7))+'月':c.markerShort||c.lunar,normalBg:normalBg,restKind:c.restKind,background:selected?'#4F378B':normalBg,color:normal,normalSub:!c.inside?'#625C68':markColor,subColor:!c.inside?'#625C68':selected?'#EADDFF':markColor,badgeColor:c.badge==='班'?'#94D99A':c.badge==='休'?'#FFB4AB':'#D0BCFF'}
        if(create)days.push(next);else this.patch(days[col],next)
        this.cellIndexes[c.key]=[r,col]
      }if(create)weeks.push({days:days})}
      if(create)this.weeks=weeks;this.gridStamp=stamp
    }else if(this.selected!==this.gridSelected){
      this.highlight(this.gridSelected,false);this.highlight(this.selected,true)
    }
    this.gridSelected=this.selected;this.visibleMonth=this.monthKey
  },
  renderSelection(){
    const stamp=this.selected+'|'+calendar.settingsKey(this.settings)
    if(stamp===this.summaryStamp)return
    this.summaryStamp=stamp;this.scopeLabel=calendar.countryName(this.settings.country)
    const d=this.detail?this.selectedInfo():calendar.preview(this.selected,this.settings);if(!d)return
    const rest=calendar.restInfo(this.selected);this.selectedRestColor=rest.kind==='holiday'?'#FFB4AB':rest.kind==='work'?'#94D99A':rest.kind==='weekend'?'#A8C7FA':'#CAC4D0';this.selectedRest=rest.kind==='holiday'?'連休'+rest.days+'天 · '+this.shortDate(rest.start)+'–'+this.shortDate(rest.end):rest.kind==='work'?'補班日 · 非休假':rest.kind==='weekend'?'一般週末 · 週休二日參考':rest.kind==='unknown'?'本年調休未收錄':'一般平日'
    this.selectedLabel=Number(this.selected.slice(5,7))+'/'+Number(this.selected.slice(8));this.selectedLunar=d.lunar?d.lunar.text:'';this.selectedStatus=d.status
    const count=d.events?d.events.length:d.eventCount,first=d.events?(count?d.events[0].n:''):d.firstEvent
    this.selectedEvent=count?(first+(count>1?' · 另'+(count-1)+'組':'')):'當日未收錄節日'
    const state=rest.kind==='holiday'?'連休'+rest.days+'天':rest.kind==='work'?'補班':rest.kind==='weekend'?'一般週末':rest.kind==='unknown'?'調休未收錄':'一般平日'
    this.previewTitle=this.selectedLabel+' · '+state;this.previewSubtitle=(count?first:'未收錄節日')+' · 點此看詳情'
  },
  highlight(key,selected){const index=this.cellIndexes[key];if(!index)return;const c=this.weeks[index[0]].days[index[1]];c.background=selected?'#4F378B':c.normalBg;c.subColor=selected?'#EADDFF':c.normalSub},
  shortDate(s){return Number(s.slice(5,7))+'/'+Number(s.slice(8))},
  selectedInfo(){
    const k=this.selected+'|'+calendar.settingsKey(this.settings)
    for(let i=this.detailCache.length-1;i>=0;i--)if(this.detailCache[i].key===k)return this.detailCache[i].info
    const info=calendar.info(this.selected,this.settings,true);if(info){this.detailCache.push({key:k,info:info});if(this.detailCache.length>4)this.detailCache.shift()}return info
  },
  prepareDetail(){
    const d=this.selectedInfo();if(!d)return
    const stamp=this.selected+'|'+calendar.settingsKey(this.settings)
    if(stamp===this.detailStamp)return
    this.detailStamp=stamp;this.detailPage=0
    this.detailDate=this.selected+' 星期'+['日','一','二','三','四','五','六'][d.weekday]
    this.detailLunar=d.lunar?d.lunar.year+' · '+d.lunar.zodiac+' · '+d.lunar.text:''
    this.detailCount=d.events.length+' 組節日 · 國別範圍：'+this.scopeLabel
    this.detailPages=Math.max(1,Math.ceil(d.events.length/8));this.applyDetailPage();this.detailReady=true;this.resetDetailScroll()
  },
  applyDetailPage(){
    const d=this.selectedInfo();this.detailPageLabel='第 '+(this.detailPage+1)+' / '+this.detailPages+' 頁';this.previousPageColor=this.detailPage>0?'#D0BCFF':'#625C68';this.nextPageColor=this.detailPage<this.detailPages-1?'#D0BCFF':'#625C68'
    const next=d.events.slice(this.detailPage*8,this.detailPage*8+8).map(e=>{
      const name=e.n.length>96?e.n.slice(0,95)+'…':e.n
      const titleHeight=Math.max(28,Math.ceil(name.length/( /[^\x00-\x7F]/.test(name)?12:22))*28)
      return {n:name,c:e.c,kindLabel:kinds[e.kind],color:e.kind==='work'?'#94D99A':e.kind==='rest'?'#FFB4AB':'#D0BCFF',titleHeight:titleHeight,height:titleHeight+102}
    })
    while(this.detailEvents.length>next.length)this.detailEvents.pop()
    for(let i=0;i<next.length;i++){if(i<this.detailEvents.length)this.patch(this.detailEvents[i],next[i]);else this.detailEvents.push(next[i])}
  },
  resetDetailScroll(){
    const generation=++this.scrollGeneration,stamp=this.detailStamp
    const reset=()=>{if(!this.alive||this.hidden||!this.detail||generation!==this.scrollGeneration||stamp!==this.detailStamp||!this.$element)return;const list=this.$element('detail-list');if(list)list.scrollTo({index:0,behavior:'instant'})}
    if(this.$nextTick)this.$nextTick(reset);else{if(this.pageTimer)clearTimeout(this.pageTimer);this.pageTimer=setTimeout(reset,0)}
  },
  changeDetailPage(delta){const page=Math.max(0,Math.min(this.detailPages-1,this.detailPage+delta));if(page===this.detailPage)return;this.detailPage=page;this.applyDetailPage();this.resetDetailScroll()},
  previousDetailPage(){this.changeDetailPage(-1)},nextDetailPage(){this.changeDetailPage(1)},
  afterLayout(callback){if(this.$nextTick)this.$nextTick(callback);else{if(this.mainTimer)clearTimeout(this.mainTimer);this.mainTimer=setTimeout(callback,0)}},
  resetCalendarScroll(){const generation=++this.mainScrollGeneration;this.afterLayout(()=>{if(!this.alive||this.hidden||!this.isCalendar()||generation!==this.mainScrollGeneration||!this.$element)return;const list=this.$element('calendar-list');if(list)list.scrollTo({index:0,behavior:'instant'})})},
  updateNav(){this.previousColor=this.monthKey>calendar.data.minDate.slice(0,7)+'-01'?'#D0BCFF':'#625C68';this.nextColor=this.monthKey<calendar.data.maxDate.slice(0,7)+'-01'?'#D0BCFF':'#625C68';this.previousDayColor=this.selected>calendar.data.minDate?'#D0BCFF':'#625C68';this.nextDayColor=this.selected<calendar.data.maxDate?'#D0BCFF':'#625C68'},
  selectDate(key){
    if(!calendar.valid(key)){this.navHint='此版本支援 2025–2028 年';return false}
    if(!this.isCalendar())return false
    if(key===this.selected){this.openDetail();return true}
    const changedMonth=this.monthKey!==key.slice(0,7)+'-01'
    this.selected=key;this.preferredDay=Number(key.slice(8));this.monthKey=key.slice(0,7)+'-01';this.navHint='';this.render();if(changedMonth)this.resetCalendarScroll();return true
  },
  openDetail(){if(!calendar.valid(this.selected)||!this.isCalendar())return;this.setScreen('detail');this.detailStamp='';this.navHint='';this.render()},
  showDateDetail(key){if(!calendar.valid(key))return false;this.selected=key;this.preferredDay=Number(key.slice(8));this.monthKey=key.slice(0,7)+'-01';this.setScreen('detail');this.detailStamp='';this.navHint='';this.render();return true},
  closeDetail(){const moved=this.visibleMonth!==this.monthKey;this.setScreen('calendar');this.applyPending();this.navHint='';this.render();if(moved)this.resetCalendarScroll()},
  moveMonth(delta){if(!this.isCalendar())return;const key=nav.moveMonth(this.selected,delta,this.preferredDay);if(!key){this.navHint=delta<0?'已到最早 2025 年 1 月':'已到最晚 2028 年 12 月';return}this.selected=key;this.monthKey=key.slice(0,7)+'-01';this.navHint='';this.render();this.resetCalendarScroll()},
  previous(){this.moveMonth(-1)},next(){this.moveMonth(1)},
  moveDetailDay(delta){if(!this.detail)return;const key=nav.moveDay(this.selected,delta);if(!key){this.navHint=delta<0?'已到最早 2025/1/1':'已到最晚 2028/12/31';return}this.showDateDetail(key)},
  previousDay(){this.moveDetailDay(-1)},nextDay(){this.moveDetailDay(1)},
  detailToday(){const key=calendar.today();if(calendar.valid(key))this.showDateDetail(key);else this.navHint='今天超出資料範圍'},
  goToday(){const key=calendar.today();if(!calendar.valid(key)){this.navHint='今天超出 2025–2028 年資料範圍';return}this.setScreen('calendar');this.applyPending();this.selected=key;this.preferredDay=Number(key.slice(8));this.monthKey=key.slice(0,7)+'-01';this.navHint='';this.render();this.resetCalendarScroll()},
  openJump(){if(!this.isCalendar())return;this.jumpYear=Number(this.monthKey.slice(0,4));this.setScreen('jump');this.jumpReady=true;this.navHint='';this.render()},
  renderJump(){const stamp=this.jumpYear+'|'+this.monthKey;if(stamp===this.jumpStamp)return;this.jumpStamp=stamp;const rows=[];for(let r=0;r<4;r++){const months=[];for(let c=0;c<3;c++){const month=r*3+c+1,key=this.jumpYear+'-'+('0'+month).slice(-2);months.push({month:month,label:month+'月',background:key===this.monthKey.slice(0,7)?'#4F378B':'#211F26'})}rows.push({months:months})}this.jumpRows=rows;this.previousYearColor=this.jumpYear>2025?'#D0BCFF':'#625C68';this.nextYearColor=this.jumpYear<2028?'#D0BCFF':'#625C68'},
  moveJumpYear(delta){const year=this.jumpYear+delta;if(year<2025||year>2028){this.navHint='支援年份：2025–2028';return}this.jumpYear=year;this.navHint='';this.renderJump()},
  previousYear(){this.moveJumpYear(-1)},nextYear(){this.moveJumpYear(1)},
  chooseMonth(month){if(!this.jump||month<1||month>12||Math.floor(month)!==month)return;const key=nav.dateInMonth(this.jumpYear+'-'+('0'+month).slice(-2),this.preferredDay);if(!key)return;this.selected=key;this.monthKey=key.slice(0,7)+'-01';this.closeJump();this.resetCalendarScroll()},
  closeJump(){this.setScreen('calendar');this.applyPending();this.navHint='';this.render()},
  openOptions(){this.setScreen('options');this.optionsReady=true;this.navHint='';this.render()},
  renderOptions(){this.scopeLabel=calendar.countryName(this.settings.country);this.scopeSource=this.sessionCountry===null?(this.saved?'跟隨手機：':'預設：')+this.scopeLabel:'暫時範圍：'+this.scopeLabel;this.globalLabel=(this.settings.country==='ALL'?'✓ ':'')+'全球節日';this.chinaLabel=(this.settings.country==='CN'?'✓ ':'')+'僅中國大陸';this.phoneScopeLabel=this.saved?'恢復手機設定：'+calendar.countryName(this.saved.settings.country):'尚未同步手機設定'},
  chooseScope(country){if(country!=='ALL'&&country!=='CN')return;this.sessionCountry=country;this.settings=Object.assign({},this.settings,{country:country});this.summaryStamp='';this.renderOptions()},
  chooseGlobal(){this.chooseScope('ALL')},chooseChina(){this.chooseScope('CN')},
  followPhone(){if(!this.saved){this.syncStatus='請先同步手機設定';return}this.sessionCountry=null;this.pendingSettings=null;this.applySettings(this.saved.settings);this.renderOptions();this.syncStatus='已恢復手機顯示設定'},
  toggleScope(){this.chooseScope(this.settings.country==='ALL'?'CN':'ALL');if(this.isCalendar())this.render()},
  closeOptions(){this.setScreen('calendar');this.applyPending();this.navHint='';this.render()},
  openLegal(){this.legalReturn=this.options?'options':this.detail?'detail':'calendar';this.setScreen('legal')},
  closeLegal(){this.setScreen(this.legalReturn);if(this.isCalendar())this.applyPending();this.render()},
  onBackPress(){if(this.legal){this.closeLegal();return true}if(this.jump){this.closeJump();return true}if(this.options){this.closeOptions();return true}if(this.detail){this.closeDetail();return true}return false},
  onDestroy(){this.alive=false;this.scrollGeneration++;this.mainScrollGeneration++;this.syncGeneration++;if(this.mainTimer)clearTimeout(this.mainTimer);if(this.pageTimer)clearTimeout(this.pageTimer);this.detailCache=[];if(this.waitTimer)clearTimeout(this.waitTimer);if(this.connection){this.connection.onopen=null;this.connection.onclose=null;this.connection.onerror=null;this.connection.onmessage=null}}
}
</script>
<style>
.root{width:336px;background-color:#141218;flex-direction:column;align-items:center;}
.screen{width:336px;}
.head-item{width:336px;height:92px;}
.head{width:304px;height:92px;margin-left:16px;flex-direction:column;}
.title-row{width:304px;height:44px;align-items:center;justify-content:space-between;}
.title{font-size:21px;color:#E6E0E9;}
.top-action{font-size:18px;color:#D0BCFF;height:44px;width:56px;text-align:center;}
.month-row{width:304px;height:48px;align-items:center;justify-content:space-between;}
.arrow{width:48px;height:48px;text-align:center;font-size:31px;color:#D0BCFF;}
.month-title{font-size:24px;color:#E6E0E9;height:48px;}
.preview-item{width:336px;height:56px;}
.preview{width:304px;height:54px;margin-left:16px;background-color:#2B2438;border-radius:12px;padding-left:10px;flex-direction:column;}
.preview-title{font-size:20px;height:26px;width:284px;}
.preview-subtitle{font-size:14px;color:#CAC4D0;width:284px;height:21px;text-overflow:ellipsis;}
.date-colors-item{width:336px;height:20px;}
.date-colors{width:304px;margin-left:16px;height:20px;justify-content:space-between;}
.legend-rest{font-size:13px;color:#FFB4AB;}
.legend-work{font-size:13px;color:#94D99A;}
.legend-weekend{font-size:13px;color:#A8C7FA;}
.weeknames-item{width:336px;height:26px;}
.weeknames{width:308px;margin-left:14px;height:26px;}
.weekday{width:44px;height:26px;font-size:16px;text-align:center;color:#CAC4D0;}
.week-item{width:336px;height:46px;}
.week{width:308px;height:46px;margin-left:14px;}
.cell{position:relative;width:44px;height:45px;border-radius:10px;}
.day{position:absolute;left:0px;top:0px;width:32px;height:27px;font-size:23px;text-align:center;}
.badge{position:absolute;right:0px;top:6px;font-size:11px;width:12px;height:13px;}
.lunar{position:absolute;left:0px;top:27px;width:44px;height:17px;font-size:12px;text-align:center;}
.usage-item{width:336px;height:60px;}
.hint{width:288px;margin-left:24px;font-size:15px;color:#AEA8B4;margin-top:8px;}
.section-item{width:336px;height:38px;}
.section{font-size:20px;color:#E6E0E9;margin-left:20px;height:38px;}
.break-empty-item{width:336px;height:90px;}
.break-content{width:292px;margin-left:22px;flex-direction:column;}
.empty-title{font-size:20px;color:#CAC4D0;margin-top:8px;margin-left:20px;}
.muted{font-size:15px;color:#CAC4D0;margin-top:6px;}
.holiday-item{width:336px;height:82px;}
.holiday-card{width:304px;height:74px;margin-left:16px;padding:12px;border-radius:16px;background-color:#211F26;flex-direction:column;}
.holiday-name{font-size:20px;color:#FFB4AB;height:27px;}
.calendar-foot{width:336px;height:168px;}
.foot-content{width:288px;margin-left:24px;flex-direction:column;}
.link{font-size:18px;color:#D0BCFF;height:48px;margin-top:8px;}
.back-item{width:336px;height:52px;}
.back{font-size:20px;color:#D0BCFF;margin-left:20px;height:52px;}
.day-nav-item{width:336px;height:56px;}
.day-nav{width:304px;margin-left:16px;height:52px;align-items:center;justify-content:space-between;}
.day-action{font-size:18px;color:#D0BCFF;width:96px;height:52px;text-align:center;border-radius:14px;background-color:#211F26;}
.detail-head-item{width:336px;height:208px;}
.detail-head{width:296px;margin-left:20px;flex-direction:column;}
.detail-date{font-size:25px;color:#E6E0E9;height:38px;}
.detail-lunar{font-size:18px;color:#D0BCFF;height:30px;}
.selected-rest{font-size:19px;height:32px;}
.detail-status{font-size:17px;color:#CAC4D0;height:40px;}
.event-item{width:336px;}
.event-content{width:304px;margin-left:16px;padding:12px;flex-direction:column;background-color:#211F26;border-radius:16px;}
.event-kind{font-size:15px;height:25px;}
.event-name{font-size:22px;width:280px;color:#E6E0E9;margin-top:4px;}
.event-country{font-size:16px;width:280px;height:50px;color:#CAC4D0;margin-top:5px;}
.empty-item{width:336px;height:88px;}
.pager-item{width:336px;height:70px;}
.pager{width:304px;margin-left:16px;height:62px;align-items:center;justify-content:space-between;}
.page-button{width:92px;height:52px;font-size:19px;color:#D0BCFF;text-align:center;background-color:#211F26;border-radius:14px;}
.page-label{font-size:14px;color:#CAC4D0;}
.notice-item{width:336px;height:248px;}
.notice{width:288px;margin-left:24px;padding-top:8px;flex-direction:column;}
.year-item{width:336px;height:56px;}
.year-nav{width:304px;height:52px;margin-left:16px;align-items:center;justify-content:space-between;}
.year{font-size:28px;color:#E6E0E9;}
.jump-hint{width:336px;height:44px;}
.month-choice-item{width:336px;height:64px;}
.month-choices{width:304px;height:60px;margin-left:16px;justify-content:space-between;}
.month-choice{width:96px;height:56px;border-radius:14px;font-size:22px;color:#E6E0E9;text-align:center;}
.options-heading{width:336px;height:86px;}
.options-content{width:292px;margin-left:22px;flex-direction:column;}
.options-title{font-size:26px;color:#E6E0E9;height:38px;}
.option-item{width:336px;height:60px;}
.option{width:304px;height:52px;margin-left:16px;padding-left:14px;background-color:#211F26;border-radius:14px;font-size:19px;color:#D0BCFF;}
.options-help{width:336px;height:88px;}
.sync-status-item{width:336px;height:88px;}
.legal-source{width:336px;height:280px;}
.legal-item{width:336px;height:210px;}
.legal-text{width:288px;margin-left:24px;margin-top:12px;font-size:18px;color:#CAC4D0;}
</style>
